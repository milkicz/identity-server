# ---------------------------------------------------------------
# Environment variables required by the IdentityServer backend.
# Copy this file and set values for your target environment.
# Do NOT commit real secrets to source control.
# ---------------------------------------------------------------

# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=identity;Username=postgres;Password=<your-password>

# JWT
Jwt__Issuer=IdentityServer
Jwt__AccessTokenTTL=00:15:00
Jwt__RefreshTokenTTL=7.00:00:00

# CORS (semicolon-separated origins)
Cors__AllowedOrigins__0=http://localhost:5173
